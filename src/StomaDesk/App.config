<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>

  <!--
    The clinic's PostgreSQL database. The build copies this file next to the exe as StomaDesk.exe.config,
    so on another computer the connection is changed there, without rebuilding.
    On first start the app creates its tables and fills an empty database with demo data.
    For a single run, the db command-line option overrides it (see the list of options in Program.cs).
  -->
  <connectionStrings>
    <add name="StomaDesk"
         providerName="Npgsql"
         connectionString="Host=localhost;Port=5432;Database=stomadesk;Username=stomadesk;Password=stomadesk" />
  </connectionStrings>
</configuration>
