<Project Sdk="Microsoft.NET.Sdk">

  <!--
    iStoma was started in 2012, the year of Visual Studio 2012, .NET Framework 4.5 and C# 5.
    LangVersion 5 makes the compiler reject anything newer (string interpolation, ?., nameof,
    expression-bodied members, out var, tuples), so the code reads like a WinForms codebase of that era.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net45</TargetFramework>
    <LangVersion>5</LangVersion>
    <RootNamespace>StomaDesk</RootNamespace>
    <AssemblyName>StomaDesk</AssemblyName>
    <Product>StomaDesk</Product>
    <AssemblyTitle>StomaDesk, gestiune cabinet stomatologic</AssemblyTitle>
    <Version>1.0.0</Version>
    <!-- Keeps Application.ProductVersion at "1.0.0" instead of appending the git commit hash. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!--
    PostgreSQL driver. Npgsql 4.0 is the last line that still runs on .NET Framework 4.5 (4.1 needs 4.6.1);
    it speaks SCRAM-SHA-256, the password method PostgreSQL uses by default.
  -->
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="4.0.17" />
  </ItemGroup>

  <!-- The schema travels inside the exe; ClinicDatabase runs it at every start. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\Schema.sql" LogicalName="StomaDesk.Data.Schema.sql" />
  </ItemGroup>

  <!-- Lets the .NET SDK build a .NET Framework 4.5 exe on Linux (no Windows or Visual Studio needed). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Designer nesting, the same entries Visual Studio writes for forms and user controls. -->
  <ItemGroup>
    <Compile Update="Controls\OdontogramControl.cs" SubType="Component" />
    <Compile Update="Controls\NavBar.cs" SubType="Component" />
    <Compile Update="Controls\Card.cs" SubType="Component" />
    <Compile Update="Controls\Badge.cs" SubType="Component" />
    <Compile Update="Controls\Avatar.cs" SubType="Component" />
    <Compile Update="Forms\StoreView.cs" SubType="UserControl" />
    <Compile Update="Forms\MainForm.cs" SubType="Form" />
    <Compile Update="Forms\MainForm.Designer.cs" DependentUpon="MainForm.cs" />
    <Compile Update="Forms\PatientsView.cs" SubType="UserControl" />
    <Compile Update="Forms\PatientsView.Designer.cs" DependentUpon="PatientsView.cs" />
    <Compile Update="Forms\AgendaView.cs" SubType="UserControl" />
    <Compile Update="Forms\AgendaView.Designer.cs" DependentUpon="AgendaView.cs" />
    <Compile Update="Forms\ReportsView.cs" SubType="UserControl" />
    <Compile Update="Forms\ReportsView.Designer.cs" DependentUpon="ReportsView.cs" />
    <Compile Update="Forms\SettingsView.cs" SubType="UserControl" />
    <Compile Update="Forms\SettingsView.Designer.cs" DependentUpon="SettingsView.cs" />
    <Compile Update="Forms\PatientForm.cs" SubType="Form" />
    <Compile Update="Forms\PatientForm.Designer.cs" DependentUpon="PatientForm.cs" />
    <Compile Update="Forms\AppointmentForm.cs" SubType="Form" />
    <Compile Update="Forms\AppointmentForm.Designer.cs" DependentUpon="AppointmentForm.cs" />
    <Compile Update="Forms\PatientCardForm.cs" SubType="Form" />
    <Compile Update="Forms\PatientCardForm.Designer.cs" DependentUpon="PatientCardForm.cs" />
  </ItemGroup>

</Project>
